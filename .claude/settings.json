{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "askUserQuestionTimeout": "60s",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "autoCompactWindow": 305000,
  "cleanupPeriodDays": 7,
  "disableClaudeAiConnectors": true,
  "effortLevel": "high",
  "enableWorkflows": true,
  "enabledPlugins": {
    "agent-browser-plugin@sinon": true,
    "agent-desktop-plugin@sinon": true,
    "astryx@astryx": true,
    "claude-security@claude-plugins-official": true,
    "clear-writing@sinon": true,
    "code-simplifier@claude-plugins-official": true,
    "codegraph-plugin@sinon": true,
    "context7@claude-plugins-official": true,
    "ddgs-plugin@sinon": true,
    "discernment-nudge@anthropic-agent-skills": true,
    "frontend-design@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "grafana-core@grafana-skills": true,
    "i-have-adhd@i-have-adhd": true,
    "kotest-skills@kotest": true,
    "kotlin-lsp@claude-plugins-official": true,
    "modern-web-guidance@googlechrome": true,
    "plugin-dev@claude-plugins-official": true,
    "pstack@cursor-plugins": true,
    "rea@rea": true,
    "stop-slop@sinon": true,
    "superpowers@superpowers-marketplace": true,
    "swift-lsp@claude-plugins-official": false,
    "workgraph@sinon": true
  },
  "env": {
    "ANTHROPIC_API_KEY": "sk-dummy",
    "ANTHROPIC_BASE_URL": "http://localhost:8317",
    "ANTHROPIC_CUSTOM_MODEL_OPTION": "glm-5.4",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION": "GLM-5.4 for coding and agent workflows.",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_NAME": "GLM-5.4",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "gpt-6.2-astra",
    "ANTHROPIC_DEFAULT_FABLE_MODEL_DESCRIPTION": "Our most capable model for complex coding and professional work.",
    "ANTHROPIC_DEFAULT_FABLE_MODEL_NAME": "GPT-6.2-Astra",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "gpt-6-luna",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL_DESCRIPTION": "Fast and affordable model for easier tasks.",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME": "GPT-6-Luna",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "gpt-6.2-sol",
    "ANTHROPIC_DEFAULT_OPUS_MODEL_DESCRIPTION": "Fast, go-to model for coding and everyday work.",
    "ANTHROPIC_DEFAULT_OPUS_MODEL_NAME": "GPT-6.2-Sol",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "gpt-6.1-terra",
    "ANTHROPIC_DEFAULT_SONNET_MODEL_DESCRIPTION": "Efficient model that excels at visual understanding and computer use.",
    "ANTHROPIC_DEFAULT_SONNET_MODEL_NAME": "GPT-6.1-Terra",
    "API_FORCE_IDLE_TIMEOUT": "0",
    "API_TIMEOUT_MS": "1800000",
    "BASH_DEFAULT_TIMEOUT_MS": "270000",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_DISABLE_AGENT_PROGRESS_SUMMARIES": "1",
    "CLAUDE_CODE_ENABLE_FINE_GRAINED_TOOL_STREAMING": "1",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1",
    "CLAUDE_CODE_EXPERIMENTAL_CODE_MODE": "1",
    "CLAUDE_CODE_GATEWAY_HINT_HEADERS": "true",
    "CLAUDE_CODE_GOAL_CHECKIN_MINUTES": "4",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "292000",
    "CLAUDE_CODE_MCP_AUTO_BACKGROUND_MS": "270000",
    "CLAUDE_CODE_REMOTE_SEND_KEEPALIVES": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku",
    "CLAUDE_CODE_WORKFLOW_MAX_CONCURRENT_AGENTS": "4",
    "CLAUDE_STREAM_FIRST_BYTE_TIMEOUT_MS": "270000",
    "CLAUDE_STREAM_IDLE_TIMEOUT_MS": "270000",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "ENABLE_TOOL_SEARCH": "true",
    "NODE_USE_SYSTEM_CA": "1"
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "autoUpdate": true,
      "source": {
        "ref": "main",
        "repo": "anthropics/skills",
        "source": "github"
      }
    },
    "astryx": {
      "autoUpdate": true,
      "source": {
        "ref": "main",
        "repo": "meta/astryx",
        "source": "github"
      }
    },
    "claude-plugins-official": {
      "autoUpdate": true,
      "source": {
        "ref": "main",
        "repo": "anthropics/claude-plugins-official",
        "source": "github"
      }
    },
    "cursor-plugins": {
      "autoUpdate": true,
      "source": {
        "ref": "main",
        "repo": "cursor/plugins",
        "source": "github"
      }
    },
    "googlechrome": {
      "autoUpdate": true,
      "source": {
        "ref": "main",
        "repo": "GoogleChrome/modern-web-guidance",
        "source": "github"
      }
    },
    "grafana-skills": {
      "autoUpdate": true,
      "source": {
        "ref": "main",
        "repo": "grafana/skills",
        "source": "github"
      }
    },
    "i-have-adhd": {
      "autoUpdate": true,
      "source": {
        "ref": "main",
        "repo": "ayghri/i-have-adhd",
        "source": "github"
      }
    },
    "kotest": {
      "autoUpdate": true,
      "source": {
        "ref": "master",
        "repo": "kotest/kotest",
        "source": "github"
      }
    },
    "rea": {
      "autoUpdate": true,
      "source": {
        "ref": "main",
        "repo": "morluto/rea",
        "source": "github"
      }
    },
    "sinon": {
      "autoUpdate": true,
      "source": {
        "ref": "main",
        "repo": "ririnto/sinon",
        "source": "github"
      }
    },
    "superpowers-marketplace": {
      "autoUpdate": true,
      "source": {
        "ref": "main",
        "repo": "obra/superpowers-marketplace",
        "source": "github"
      }
    }
  },
  "fallbackModel": ["glm-5.3-flash", "claude-sonnet-5-5", "gpt-6.1-terra"],
  "feedbackSurveyRate": 0,
  "includeGitInstructions": false,
  "language": "Korean",
  "model": "opus",
  "modelPricing": {
    "overrides": {
      "gemini-3.8-flash": {
        "cacheRead": 0.075,
        "cacheWrite": 0,
        "input": 0.75,
        "output": 3.75
      },
      "gemini-4-argon": {
        "cacheRead": 0.1,
        "cacheWrite": 0,
        "input": 2,
        "output": 10
      },
      "glm-5.3-flash": {
        "cacheRead": 0.03,
        "cacheWrite": 0,
        "input": 0.15,
        "output": 0.5
      },
      "gpt-6-luna": {
        "cacheRead": 0.01,
        "cacheWrite": 0.125,
        "input": 0.1,
        "output": 0.5
      },
      "gpt-6.2-astra": {
        "cacheRead": 0.4,
        "cacheWrite": 10,
        "input": 8,
        "output": 40
      },
      "gpt-6.2-sol": {
        "cacheRead": 0.1,
        "cacheWrite": 2.5,
        "input": 2,
        "output": 10
      }
    }
  },
  "modelSettings": {
    "claude-fable-5-2": {
      "autoCompactWindow": 305000,
      "effortLevel": "high",
      "maxEffortLevel": "xhigh"
    },
    "claude-haiku-5-5": {
      "autoCompactWindow": 128000,
      "effortLevel": "medium",
      "maxEffortLevel": "high"
    },
    "claude-opus-5-5": {
      "autoCompactWindow": 305000,
      "effortLevel": "medium",
      "maxEffortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "autoCompactWindow": 305000,
      "effortLevel": "medium",
      "maxEffortLevel": "high"
    },
    "gemini-3.8-flash": {
      "autoCompactWindow": 305000,
      "effortLevel": "medium",
      "maxEffortLevel": "high"
    },
    "gemini-4-argon": {
      "autoCompactWindow": 305000,
      "effortLevel": "medium",
      "maxEffortLevel": "high"
    },
    "glm-5.3-flash": {
      "autoCompactWindow": 305000,
      "effortLevel": "xhigh",
      "maxEffortLevel": "max"
    },
    "gpt-6-luna": {
      "autoCompactWindow": 305000,
      "effortLevel": "xhigh",
      "maxEffortLevel": "max"
    },
    "gpt-6.2-astra": {
      "autoCompactWindow": 305000,
      "effortLevel": "low",
      "maxEffortLevel": "xhigh"
    },
    "gpt-6.2-sol": {
      "autoCompactWindow": 305000,
      "effortLevel": "high",
      "maxEffortLevel": "high"
    },
    "glm-5.4": {
      "autoCompactWindow": 305000,
      "effortLevel": "xhigh",
      "maxEffortLevel": "max"
    }
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Agent(claude)",
      "AskUserQuestion",
      "Bash(sleep*)",
      "EnterPlanMode"
    ]
  },
  "pluginConfigs": {
    "cc-plugin-agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "promptSuggestionEnabled": false,
  "respondToBashCommands": false,
  "sandbox": {
    "allowUnsandboxedCommands": true
  },
  "showClearContextOnPlanAccept": true,
  "showMessageTimestamps": true,
  "showThinkingSummaries": true,
  "skillOverrides": {
    "code-review": "off"
  },
  "skipAutoPermissionPrompt": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWebFetchPreflight": true,
  "statusLine": {
    "command": "node \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/statusline.mjs\"",
    "type": "command"
  },
  "subagentStatusLine": {
    "command": "node \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/subagent-statusline.mjs\"",
    "type": "command"
  },
  "teammateMode": "auto",
  "theme": "auto",
  "totalTokensReminder": "countdown",
  "tui": "fullscreen",
  "ultracode": true,
  "verbose": true,
  "viewMode": "focus",
  "worktree": {
    "baseRef": "head"
  }
}
