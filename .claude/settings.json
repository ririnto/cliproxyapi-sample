{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "allowAllClaudeAiMcps": false,
  "askUserQuestionTimeout": "60s",
  "disableClaudeAiConnectors": true,
  "disallowedTools": ["AskUserQuestion", "EnterPlanMode"],
  "editorMode": "normal",
  "env": {
    "ANTHROPIC_API_KEY": "sk-dummy",
    "ANTHROPIC_BASE_URL": "http://localhost:8317",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "gpt-6-astra[1m]",
    "ANTHROPIC_DEFAULT_FABLE_MODEL_DESCRIPTION": "GPT-6 Astra - flagship reasoning, routes the hardest long-horizon tasks",
    "ANTHROPIC_DEFAULT_FABLE_MODEL_NAME": "GPT-6 Astra",
    "ANTHROPIC_DEFAULT_FABLE_MODEL_SUPPORTED_CAPABILITIES": "effort,interleaved_thinking,max_effort,temperature,thinking,xhigh_effort,adaptive_thinking",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "glm-5.3-flash[1m]",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL_DESCRIPTION": "GLM-5.3 Flash - fastest for quick answers and subagent sweeps",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME": "GLM-5.3 Flash",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL_SUPPORTED_CAPABILITIES": "effort,interleaved_thinking,max_effort,temperature,thinking,xhigh_effort,adaptive_thinking",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "gpt-6-sol[1m]",
    "ANTHROPIC_DEFAULT_OPUS_MODEL_DESCRIPTION": "GPT-6 Sol - main-loop coding model, best for complex everyday tasks",
    "ANTHROPIC_DEFAULT_OPUS_MODEL_NAME": "GPT-6 Sol",
    "ANTHROPIC_DEFAULT_OPUS_MODEL_SUPPORTED_CAPABILITIES": "effort,interleaved_thinking,max_effort,temperature,thinking,xhigh_effort,adaptive_thinking",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "gpt-6-luna[1m]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL_DESCRIPTION": "GPT-6 Luna - balanced efficiency for routine coding tasks",
    "ANTHROPIC_DEFAULT_SONNET_MODEL_NAME": "GPT-6 Luna",
    "ANTHROPIC_DEFAULT_SONNET_MODEL_SUPPORTED_CAPABILITIES": "effort,interleaved_thinking,max_effort,temperature,thinking,xhigh_effort,adaptive_thinking",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "85",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "272000",
    "CLAUDE_CODE_DISABLE_ADVISOR_TOOL": "1",
    "CLAUDE_CODE_DISABLE_FAST_MODE": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2",
    "CLAUDE_CODE_REMOTE_SEND_KEEPALIVES": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "autoUpdate": true,
      "source": {
        "repo": "anthropics/skills",
        "source": "github"
      }
    },
    "ponytail": {
      "autoUpdate": true,
      "source": {
        "repo": "DietrichGebert/ponytail",
        "source": "github"
      }
    }
  },
  "fallbackModel": ["gpt-6-luna", "glm-5.3-flash"],
  "fastMode": false,
  "feedbackSurveyRate": 0,
  "includeCoAuthoredBy": false,
  "includeGitInstructions": false,
  "language": "Korean",
  "model": "opus",
  "modelSettings": {
    "gpt-6-luna": {
      "effortLevel": "xhigh"
    },
    "glm-5.3": {
      "effortLevel": "xhigh"
    },
    "glm-5.3-flash": {
      "effortLevel": "xhigh"
    }
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": ["AskUserQuestion", "EnterPlanMode", "Agent(claude)"]
  },
  "showClearContextOnPlanAccept": true,
  "showThinkingSummaries": true,
  "showTurnDuration": true,
  "skillOverrides": {
    "claude-api": "off",
    "code-review": "off"
  },
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "command": "node ~/.claude/statusline.mjs",
    "type": "command"
  },
  "statusLineAddon": [
    {
      "provider": "zai",
      "script": "statusline/glm-coding-plan.mjs",
      "credential": "{env:ZHIPU_API_KEY}",
      "enabled": true,
      "hideName": true,
      "name": "GLM Coding Plan",
      "showAbove": 0
    },
    {
      "provider": "minimax",
      "script": "statusline/minimax-token-plan.mjs",
      "credential": "{env:MINIMAX_API_KEY}",
      "enabled": true,
      "name": "MiniMax Token Plan",
      "showAbove": {
        "5h": 5,
        "7d": 5
      }
    },
    {
      "provider": "chatgpt",
      "script": "statusline/codex-usage.mjs",
      "enabled": true,
      "name": "Chatgpt",
      "showAbove": 0
    },
    {
      "provider": "copilot",
      "script": "statusline/copilot-usage.mjs",
      "enabled": true,
      "hideLabels": ["Completions"],
      "name": "Copilot",
      "showAbove": 0
    }
  ],
  "teammateMode": "auto",
  "terminalProgressBarEnabled": true,
  "theme": "auto",
  "verbose": true,
  "workflowSizeGuideline": "small",
  "worktree": {
    "baseRef": "head"
  }
}
