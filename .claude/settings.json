{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "askUserQuestionTimeout": "60s",
  "autoCompactWindow": 305000,
  "disableClaudeAiConnectors": true,
  "disallowedTools": ["AskUserQuestion", "EnterPlanMode"],
  "effortLevel": "high",
  "env": {
    "ANTHROPIC_API_KEY": "sk-dummy",
    "ANTHROPIC_BASE_URL": "http://localhost:8317",
    "ANTHROPIC_CUSTOM_MODEL_OPTION": "glm-5.3",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION": "GLM-5.3 is Z.ai's latest flagship model, delivering comprehensive advancements in complex software engineering and agent capabilities.",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_NAME": "GLM-5.3",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_SUPPORTED_CAPABILITIES": "effort,max_effort,thinking",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "gpt-6-astra",
    "ANTHROPIC_DEFAULT_FABLE_MODEL_DESCRIPTION": "Frontier intelligence for the most demanding work.",
    "ANTHROPIC_DEFAULT_FABLE_MODEL_NAME": "GPT-6-Astra",
    "ANTHROPIC_DEFAULT_FABLE_MODEL_SUPPORTED_CAPABILITIES": "effort,xhigh_effort,max_effort,thinking",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "glm-5.3-flash",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL_DESCRIPTION": "GLM-5.3-Flash/GLM-5.3-FlashX is the first native multimodal model in the GLM-5 series, delivering stronger intelligence than GLM-5.2 at an exceptionally low cost.",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME": "GLM-5.3-Flash",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL_SUPPORTED_CAPABILITIES": "effort,max_effort,thinking",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "gpt-6.1-sol",
    "ANTHROPIC_DEFAULT_OPUS_MODEL_DESCRIPTION": "Latest workhorse model for coding and everyday work.",
    "ANTHROPIC_DEFAULT_OPUS_MODEL_NAME": "GPT-6.1-Sol",
    "ANTHROPIC_DEFAULT_OPUS_MODEL_SUPPORTED_CAPABILITIES": "effort,xhigh_effort,max_effort,thinking",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "gpt-6-luna",
    "ANTHROPIC_DEFAULT_SONNET_MODEL_DESCRIPTION": "Fast and affordable model for easier tasks.",
    "ANTHROPIC_DEFAULT_SONNET_MODEL_NAME": "GPT-6-Luna",
    "ANTHROPIC_DEFAULT_SONNET_MODEL_SUPPORTED_CAPABILITIES": "effort,xhigh_effort,max_effort,thinking",
    "API_FORCE_IDLE_TIMEOUT": "0",
    "BASH_DEFAULT_TIMEOUT_MS": "240000",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_ENABLE_FINE_GRAINED_TOOL_STREAMING": "1",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1",
    "CLAUDE_CODE_GOAL_CHECKIN_MINUTES": "4",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "400000",
    "CLAUDE_CODE_MCP_AUTO_BACKGROUND_MS": "270000",
    "CLAUDE_CODE_REMOTE_SEND_KEEPALIVES": "1",
    "CLAUDE_CODE_WORKFLOW_MAX_CONCURRENT_AGENTS": "4",
    "CLAUDE_STREAM_IDLE_TIMEOUT_MS": "600000",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "autoUpdate": true,
      "source": {
        "repo": "anthropics/skills",
        "source": "github"
      }
    },
    "claude-plugins-official": {
      "autoUpdate": true,
      "source": {
        "repo": "anthropics/claude-plugins-official",
        "source": "github"
      }
    },
    "cursor-plugins": {
      "autoUpdate": true,
      "source": {
        "repo": "cursor/plugins",
        "source": "github"
      }
    },
    "i-have-adhd": {
      "autoUpdate": true,
      "source": {
        "repo": "ayghri/i-have-adhd",
        "source": "github"
      }
    },
    "sinon": {
      "autoUpdate": true,
      "source": {
        "repo": "ririnto/sinon",
        "source": "github"
      }
    }
  },
  "feedbackSurveyRate": 0,
  "includeCoAuthoredBy": false,
  "includeGitInstructions": false,
  "language": "Korean",
  "model": "opus",
  "modelSettings": {
    "claude-fable-5-1": {
      "autoCompactWindow": 305000,
      "effortLevel": "high",
      "maxEffortLevel": "xhigh"
    },
    "claude-haiku-5-5": {
      "autoCompactWindow": 100000,
      "effortLevel": "medium",
      "maxEffortLevel": "high"
    },
    "claude-opus-5-5": {
      "autoCompactWindow": 305000,
      "effortLevel": "medium",
      "maxEffortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "autoCompactWindow": 305000,
      "effortLevel": "medium",
      "maxEffortLevel": "high"
    },
    "glm-5.3": {
      "autoCompactWindow": 305000,
      "effortLevel": "xhigh",
      "maxEffortLevel": "max"
    },
    "glm-5.3-flash": {
      "autoCompactWindow": 305000,
      "effortLevel": "xhigh",
      "maxEffortLevel": "max"
    },
    "gpt-6-astra": {
      "autoCompactWindow": 305000,
      "effortLevel": "low",
      "maxEffortLevel": "xhigh"
    },
    "gpt-6-luna": {
      "autoCompactWindow": 305000,
      "effortLevel": "xhigh",
      "maxEffortLevel": "max"
    },
    "gpt-6.1-sol": {
      "autoCompactWindow": 305000,
      "effortLevel": "high",
      "maxEffortLevel": "high"
    }
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": ["Agent(claude)"]
  },
  "promptSuggestionEnabled": false,
  "sandbox": {
    "allowUnsandboxedCommands": true
  },
  "showClearContextOnPlanAccept": true,
  "showThinkingSummaries": true,
  "skillOverrides": {
    "code-review": "off"
  },
  "skipAutoPermissionPrompt": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWebFetchPreflight": true,
  "statusLine": {
    "command": "node -e \"const path = require('node:path'); import(require('node:url').pathToFileURL(path.join(process.env.CLAUDE_CONFIG_DIR || path.join(require('node:os').homedir(), '.claude'), 'statusline.mjs'))).then(module => module.main())\"",
    "type": "command"
  },
  "statusLineAddon": [
    {
      "credential": "{env:ZHIPU_API_KEY}",
      "enabled": true,
      "hideName": true,
      "name": "GLM Coding Plan",
      "provider": "zai",
      "script": "statusline/glm-coding-plan.mjs",
      "showAbove": 0
    },
    {
      "credential": "{env:MINIMAX_API_KEY}",
      "enabled": true,
      "name": "MiniMax Token Plan",
      "provider": "minimax",
      "script": "statusline/minimax-token-plan.mjs",
      "showAbove": {
        "5h": 5,
        "7d": 5
      }
    },
    {
      "enabled": true,
      "name": "Chatgpt",
      "provider": "chatgpt",
      "script": "statusline/codex-usage.mjs",
      "showAbove": 0
    },
    {
      "enabled": true,
      "hideLabels": ["Completions"],
      "name": "Copilot",
      "provider": "copilot",
      "script": "statusline/copilot-usage.mjs",
      "showAbove": 0
    }
  ],
  "teammateMode": "auto",
  "theme": "auto",
  "totalTokensReminder": "countdown",
  "verbose": true,
  "worktree": {
    "baseRef": "head"
  }
}
