{
  "config": {
    "code-block-style": {
      "style": "fenced"
    },
    "docs/no-box-drawing": true,
    "no-emphasis-as-heading": true,
    "table-column-style": {
      "style": "compact"
    }
  },
  "customRules": ["./rules/no-box-drawing.ts"],
  "gitignore": true,
  "globs": ["**/*.md"],
  // Issue #102 requires these two verbatim copies of the authorized template.
  "ignores": [".claude/AGENTS.md", ".codex/AGENTS.md"]
}
