{
  "config": {
    "code-block-style": {
      "style": "fenced"
    },
    "docs/no-box-drawing": true,
    "line-length": false,
    "no-duplicate-heading": {
      "siblings_only": true
    },
    "no-emphasis-as-heading": true,
    "no-inline-html": {
      "allowed_elements": ["details", "summary", "kbd", "img", "code"],
      "table_allowed_elements": ["br", "code"]
    },
    "single-title": {
      "front_matter_title": ""
    },
    "table-column-style": {
      "style": "compact"
    }
  },
  "customRules": ["./rules/no-box-drawing.ts"],
  "gitignore": true,
  "globs": ["**/*.md"]
}
