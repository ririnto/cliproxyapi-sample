{
  "private": true,
  "type": "module",
  "scripts": {
    "check": "run-s --continue-on-error check:*",
    "check:generated": "node scripts/generate-config.mts --check",
    "check:markdownlint-cli2": "markdownlint-cli2",
    "check:test": "node --test \"tests/**/*.test.{mjs,mts}\"",
    "check:types": "tsc --noEmit",
    "check:ultracite": "node scripts/ultracite.mjs check",
    "fix": "run-p fix:*",
    "fix:markdownlint-cli2": "markdownlint-cli2 --fix",
    "fix:ultracite": "node scripts/ultracite.mjs fix",
    "generate": "node scripts/generate-config.mts --refresh && ultracite fix config/codex-models.json .codex/model_catalog.json",
    "pre-commit": "run-p check:markdownlint-cli2 check:ultracite",
    "pre-push": "pnpm run check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "catalog:",
    "@types/node": "catalog:",
    "husky": "catalog:",
    "markdownlint": "catalog:",
    "markdownlint-cli2": "catalog:",
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "yaml": "catalog:"
  },
  "engines": {
    "node": "^24.22.3"
  },
  "packageManager": "pnpm@12.21.0"
}
