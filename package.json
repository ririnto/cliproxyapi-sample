{
  "private": true,
  "type": "module",
  "scripts": {
    "check": "run-p --continue-on-error check:*",
    "check:generated": "node scripts/generate-config.mts --check",
    "check:generated-test": "node --test scripts/generate-config.test.mts",
    "check:markdownlint-cli2": "markdownlint-cli2",
    "check:statusline-test": "node --test scripts/statusline.test.mts",
    "check:types": "tsc --noEmit",
    "check:ultracite": "ultracite check",
    "check:workflow-input-defaults": "node --test scripts/check-workflow-input-defaults.mts scripts/check-workflow-input-defaults.test.mts",
    "fix": "run-p fix:*",
    "fix:markdownlint-cli2": "markdownlint-cli2 --fix",
    "fix:ultracite": "ultracite fix",
    "generate": "run-p generate:*",
    "generate:agents": "node scripts/generate-agents.mts",
    "generate:config": "node scripts/generate-config.mts && ultracite fix .codex/model_catalog.json",
    "pre-commit": "run-p check:markdownlint-cli2 check:ultracite",
    "pre-push": "pnpm run check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@11ty/gray-matter": "catalog:",
    "@tsconfig/node-lts": "catalog:",
    "@types/node": "catalog:",
    "husky": "catalog:",
    "markdownlint": "catalog:",
    "markdownlint-cli2": "catalog:",
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "smol-toml": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "yaml": "catalog:"
  },
  "engines": {
    "node": "^24.22.3"
  },
  "packageManager": "pnpm@12.21.0"
}
