{
  "private": true,
  "type": "module",
  "scripts": {
    "check": "run-p check:*",
    "check:markdownlint-cli2": "markdownlint-cli2",
    "check:oxlint-types": "oxlint --type-aware",
    "check:test": "run-p check:test:*",
    "check:test:tooling": "node --test \"**/*.test.mjs\" \".claude/**/*.test.mjs\"",
    "check:types": "tsc --noEmit",
    "check:ultracite": "ultracite check",
    "check:usage-cache": "node verification/usage-cache.mjs",
    "fix": "run-p fix:*",
    "fix:markdownlint-cli2": "markdownlint-cli2 --fix",
    "fix:ultracite": "ultracite fix",
    "pre-commit": "run-s check",
    "pre-push": "run-s check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "catalog:",
    "@types/node": "catalog:",
    "husky": "catalog:",
    "markdownlint": "catalog:",
    "markdownlint-cli2": "catalog:",
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:"
  },
  "engines": {
    "node": "^24.22.3"
  },
  "packageManager": "pnpm@12.21.0"
}
